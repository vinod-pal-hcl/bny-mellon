{
    "maxissues": 1000,
    "issuestates": "New,Open,InProgress,Reopened,Noise",
    "issueseverities": "Critical,High,Medium",
    "imurl": "<Jira URL>",
    "imUserName": "<username>",
    "imPassword": "<encrypted password or accesstoken. To encrypt the password run the command "node .\cryptoService.js --encrypt <password>" from the base directory.>",
    "imissuetype": "<issue type like task, bug, epic, etc.>",
    "imsummary": "Security issue: %IssueType% found by %Scanner%",
    "severitymap": {
        "<AppScan Serverity e.g. High, Low, Critical>":"<Jira priority e.g. New, Open, Close, In Progress>",
        "High":"Open",
        "Critical:"Open",
        "Low":"In Progress"
    },
     "attributeMappings": [
        {
            "imAttr": "<This is an attribute id from the IM>",
            "defaultAttrValue": "<If you want to have a hardcoded value for an IM attribute then you use this field>",
            "appScanAttr": "<This is an attribute name from AppScan>",
            "type": "<Type of attribute. Currently we support following types: String, Array, Dropdown, DateTime>"
        },
        {
            "imAttr": "customfield_10200",
            "defaultAttrValue": "",
            "appScanAttr": "ApplicationName",
            "type": "String"
        },
        {
            "imAttr": "labels",
            "defaultAttrValue": "",
            "appScanAttr": [
                "ApplicationName",
                "ApplicationId",
                "testing"
            ],
            "type": "Array"
        },
        {
            "imAttr": "customfield_10220",
            "defaultAttrValue": "ASoC - Self Service",
            "appScanAttr": "",
            "type": "Dropdown"
        },
        {
            "imAttr": "customfield_10202",
            "defaultAttrValue": "",
            "appScanAttr": "IssueType",
            "type": "String"
        },
        {
            "imAttr": "customfield_10203",
            "defaultAttrValue": "",
            "appScanAttr": "IssueTypeId",
            "type": "String"
        },
        {
            "imAttr": "customfield_10204",
            "defaultAttrValue": "",
            "appScanAttr": "Location",
            "type": "String"
        },
        {
            "imAttr": "customfield_10221",
            "defaultAttrValue": "ASoC",
            "appScanAttr": "",
            "type": "Dropdown"
        },
        {
            "imAttr": "customfield_10222",
            "defaultAttrValue": "",
            "appScanAttr": "Severity",
            "type": "Dropdown"
        },
        {
            "imAttr": "customfield_10215",
            "defaultAttrValue": "",
            "appScanAttr": "DateCreated",
            "type": "DateTime"
        },
        {
            "imAttr": "customfield_10208",
            "defaultAttrValue": "",
            "appScanAttr": "ApplicationName",
            "type": "String"
        },
        {
            "imAttr": "customfield_10211",
            "defaultAttrValue": "NA",
            "appScanAttr": "",
            "type": "String"
        },
        {
            "imAttr": "customfield_10217",
            "defaultAttrValue": "NA",
            "appScanAttr": "",
            "type": "Dropdown"
        },
        {
            "imAttr": "customfield_10218",
            "defaultAttrValue": "NA",
            "appScanAttr": "",
            "type": "Dropdown"
        }
    ],
     "jiraToAppScanStatusMapping": {
        "<Jira status>":"<AppScan status>",
        "<Jira status>":"<AppScan status>"
    },
    "appScanToJiraStatusMapping": {
        "<AppScan status>": "<Jira status>",
        "<AppScan status>": "<Jira status>",
    },
    "jiraStatusIdMapping": {
        "<Jira status name>": "<Jira status id>",
        "<Jira status name>": "<Jira status id>"
    }
}